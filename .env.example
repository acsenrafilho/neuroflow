NEUROFLOW_ENV=development
NEUROFLOW_DATA_ROOT=./data/jobs
NEUROFLOW_DATASETS_ROOT=./data/datasets
NEUROFLOW_LOG_LEVEL=INFO
# Set to 1 to serve frontend/dist from the API (http://127.0.0.1:8000/)
NEUROFLOW_SERVE_FRONTEND=1
NEUROFLOW_MAX_UPLOAD_MB=500
# Host resource gates (global): new jobs queue or wait when exceeded
NEUROFLOW_RAM_MAX_PERCENT=80
NEUROFLOW_CPU_MAX_PERCENT=90
NEUROFLOW_MAX_QUEUED_JOBS=20
# Optional: path to FreeSurfer installation (sets FREESURFER_HOME for jobs)
# NEUROFLOW_FREESURFER_HOME=/usr/local/freesurfer
# NEUROFLOW_RECON_ALL_BIN=recon-all
# Optional: FSL installation root (sets FSLDIR and prepends bin to PATH for jobs)
# NEUROFLOW_FSLDIR=/usr/local/fsl
# Optional: 3D Slicer installation directory (Slicer binary at $NEUROFLOW_SLICER_HOME/Slicer)
# NEUROFLOW_SLICER_HOME=/opt/Slicer
# Optional: JSON map of ITK module_id -> absolute path to locally compiled binary
# (default: ./config/itk-binaries.json when that file exists)
# NEUROFLOW_ITK_BINARIES_CONFIG=./config/itk-binaries.json
# Optional: ANTs installation bin directory (sets ANTSPATH and prepends to PATH for jobs)
# NEUROFLOW_ANTSPATH=/path/to/ants/bin
# Optional: Spinal Cord Toolbox installation root (sets SCT_DIR and prepends bin to PATH)
# NEUROFLOW_SCT_DIR=/home/antonio/sct_7.3

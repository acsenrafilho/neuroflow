{
  "name": "neuroflow-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "NeuroFlow production UI (independent from doc/mockup/)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./dist/assets/app.css --minify",
    "build:pages": "node scripts/copy-pages.mjs",
    "build": "npm run build:css && npm run build:pages",
    "watch": "tailwindcss -i ./src/styles/input.css -o ./dist/assets/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3"
  }
}
